android.applicationVariants.all {
    if (name == "debug") {
        tasks.register("runLiveProbe", JavaExec::class) {
            mainClass.set("com.example.ai.capabilities.federated.OpenHandsLiveProbeKt")
            classpath = javaCompileProvider.get().classpath + files(javaCompileProvider.get().destinationDirectory) + files("/opt/gradle/gradle-9.3.1/lib/kotlin-stdlib-2.1.10.jar")
        }
    }
}
